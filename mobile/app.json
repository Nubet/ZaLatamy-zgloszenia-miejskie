{
  "expo": {
    "name": "ZaŁatamy Demo",
    "slug": "zalatamy-demo",
    "scheme": "zalatamy-demo",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dodaj zdjęcia problemu do lokalnego zgłoszenia demo.",
          "cameraPermission": "Zrób zdjęcie problemu do lokalnego zgłoszenia demo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Wskaż miejsce zgłoszenia na mapie Łodzi." }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "pl.zalatamy.demo"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
